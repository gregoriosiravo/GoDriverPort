<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme tokens: cool paper-grey, deep signal-blue accent; status colours are semantic only. -->
    <Color x:Key="Color.Bg">#E8ECF0</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceRaised">#F3F5F8</Color>
    <Color x:Key="Color.Line">#C5CDD7</Color>
    <Color x:Key="Color.Text">#121A22</Color>
    <Color x:Key="Color.TextMuted">#4A5663</Color>
    <Color x:Key="Color.Accent">#0E63C9</Color>
    <Color x:Key="Color.AccentPressed">#0A4E9F</Color>
    <Color x:Key="Color.OnAccent">#FFFFFF</Color>
    <Color x:Key="Color.AccentSoft">#DCEAFB</Color>
    <Color x:Key="Color.Success">#1B7A4B</Color>
    <Color x:Key="Color.SuccessSoft">#DCF1E5</Color>
    <Color x:Key="Color.Danger">#BE3227</Color>
    <Color x:Key="Color.DangerSoft">#F9E1DE</Color>
    <Color x:Key="Color.Caution">#855600</Color>
    <Color x:Key="Color.CautionSoft">#FAEDCF</Color>
    <Color x:Key="Color.Focus">#0E63C9</Color>
    <Color x:Key="Color.Scrim">#B3101820</Color>
    <Color x:Key="Color.Disabled">#97A2AE</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Caution" Color="{StaticResource Color.Caution}" />
    <SolidColorBrush x:Key="Brush.CautionSoft" Color="{StaticResource Color.CautionSoft}" />
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.Disabled" Color="{StaticResource Color.Disabled}" />
</ResourceDictionary>
