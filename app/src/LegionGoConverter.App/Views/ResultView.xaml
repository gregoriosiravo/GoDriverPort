<UserControl x:Class="LegionGoConverter.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:LegionGoConverter.App"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=app:MainViewModel}">
    <!-- Focusable reading area: details can be longer than the screen, and the controller must be able to scroll them. -->
    <ScrollViewer x:Name="DetailsScroll" Style="{StaticResource Scroll.Reading}" Margin="16,16,16,12" TabIndex="0"
                  AutomationProperties.Name="Result details">
        <Grid Margin="16,16,16,12" MaxWidth="980" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Outcome emblem: green check (done), amber clock (installed, not verified yet), red cross (failed). -->
            <Border x:Name="Emblem" Width="88" Height="88" CornerRadius="44" VerticalAlignment="Top" Margin="0,0,28,0">
                <TextBlock x:Name="EmblemGlyph" FontSize="40">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Text" Value="&#xE711;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Success}" Value="True">
                                    <Setter Property="Text" Value="&#xE73E;" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Success}" Value="True" />
                                        <Condition Binding="{Binding VerificationPending}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Text" Value="&#xE823;" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Success}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Success}" Value="True" />
                                    <Condition Binding="{Binding VerificationPending}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Background" Value="{DynamicResource Brush.Caution}" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding ResultHeadline}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Success}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Installed, not verified yet -->
                <Border Style="{StaticResource Banner.Caution}" Margin="0,20,0,0">
                    <Border.Visibility>
                        <MultiBinding Converter="{StaticResource AllVisible}">
                            <Binding Path="Success" Converter="{StaticResource BoolVisible}" />
                            <Binding Path="VerificationPending" Converter="{StaticResource BoolVisible}" />
                        </MultiBinding>
                    </Border.Visibility>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Caution}"
                                   Text="Restart, then check" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0"
                                   Text="Windows accepted the driver, but the app could not confirm it is running. Restart, then check that the screen and games work. If they do not, come back and roll back to Lenovo's driver." />
                    </StackPanel>
                </Border>

                <!-- Failure -->
                <Border Style="{StaticResource Banner.Danger}" Margin="0,20,0,0"
                        Visibility="{Binding Error, Converter={StaticResource EmptyCollapsed}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" Text="What went wrong" />
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,6,0,0" Text="{Binding Error}" />
                    </StackPanel>
                </Border>

                <!-- Notice -->
                <Border Style="{StaticResource Banner.Info}" Margin="0,20,0,0"
                        Visibility="{Binding Notice, Converter={StaticResource EmptyCollapsed}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE946;" Foreground="{DynamicResource Brush.Accent}"
                                   VerticalAlignment="Top" Margin="0,3,14,0" />
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Notice}" />
                    </DockPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,20,0,0" Text="Save your work before restarting."
                           Visibility="{Binding RebootRequired, Converter={StaticResource BoolVisible}}" />

                <StackPanel Margin="0,24,0,0" Visibility="{Binding SessionDir, Converter={StaticResource EmptyCollapsed}}">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="Log folder" />
                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="17" Text="{Binding SessionDir}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
