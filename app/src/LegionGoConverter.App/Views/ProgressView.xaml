<UserControl x:Class="LegionGoConverter.App.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:LegionGoConverter.App"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=app:MainViewModel}">
    <UserControl.Resources>
        <!-- One stage row: state mark + title. Running is highlighted, Done is quiet, Failed is red. -->
        <DataTemplate x:Key="StageRow" DataType="{x:Type app:StageItem}">
            <Border x:Name="Row" CornerRadius="10" Padding="12,6" Margin="0,1">
                <DockPanel>
                    <Border x:Name="Dot" DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" BorderThickness="2"
                            BorderBrush="{DynamicResource Brush.Line}" Margin="0,0,14,0">
                        <TextBlock x:Name="Glyph" Style="{StaticResource Text.Icon}" FontSize="13" Text="" />
                    </Border>
                    <TextBlock x:Name="Title" Style="{StaticResource Text.Body}" FontSize="19" VerticalAlignment="Center"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding Stage, Converter={StaticResource StageTitle}}" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE768;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Success}" />
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE73E;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Surface}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Brush.Danger}" />
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE711;" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Brush.Surface}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="3" Style="{StaticResource Text.Title}" Text="Converting the driver" Margin="0,0,0,16" />

        <!-- Stages -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Stages}" ItemTemplate="{StaticResource StageRow}" Focusable="False" />
            </ScrollViewer>
        </Border>

        <!-- Current stage, progress, live log -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding StageMessage, TargetNullValue='Starting...'}" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar VerticalAlignment="Center" Value="{Binding Fraction, TargetNullValue=0, Mode=OneWay}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource Progress.Bar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Fraction}" Value="{x:Null}">
                                            <Setter Property="IsIndeterminate" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="16,0,0,0" MinWidth="56"
                                   TextAlignment="Right" Text="{Binding Fraction, StringFormat={}{0:P0}, TargetNullValue=''}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,14,0,0"
                               Text="Keep the Legion Go plugged in. The screen may flicker or go black for a moment while the driver changes." />
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="20,16,8,16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" Text="Log" Margin="0,0,0,8" />
                    <ScrollViewer x:Name="LogScroll">
                        <ItemsControl ItemsSource="{Binding Log}" Focusable="False" Margin="0,0,12,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="16" LineHeight="22" Text="{Binding}"
                                               Foreground="{DynamicResource Brush.TextMuted}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
