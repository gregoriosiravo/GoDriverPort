<UserControl x:Class="LegionGoConverter.App.Views.ReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:app="clr-namespace:LegionGoConverter.App"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=app:MainViewModel}">
    <UserControl.Resources>
        <!-- On / Off / Unknown for a security fact; Tag carries the bool (null when the state could not be read). -->
        <Style x:Key="FactValue" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Text" Value="Unknown" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Style.Triggers>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
                    <Setter Property="Text" Value="On" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </Trigger>
                <Trigger Property="Tag">
                    <Trigger.Value><sys:Boolean>False</sys:Boolean></Trigger.Value>
                    <Setter Property="Text" Value="Off" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChangeIcon" TargetType="TextBlock" BasedOn="{StaticResource Text.Icon}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,4,16,0" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
    </UserControl.Resources>

    <!-- No page scrolling: the consent card is the first, full-height content and scrolls itself (focusable, so the
         controller can read all of it); the options column scrolls on its own and its controls bring themselves into view. -->
    <Grid Margin="32,20,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource Text.Title}" Text="Check before converting" />
        <Border Grid.Row="1" Style="{StaticResource Banner.Info}" Margin="0,14,0,0"
                Visibility="{Binding Notice, Converter={StaticResource EmptyCollapsed}}">
            <DockPanel>
                <TextBlock Style="{StaticResource ChangeIcon}" Text="&#xE946;" Margin="0,3,14,0" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Notice}" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: what will change (informed consent), then the facts about this device -->
            <Border Style="{StaticResource Card}" Padding="26,20,14,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.Heading}" Text="What will change" />
                    <ScrollViewer x:Name="ConsentScroll" Style="{StaticResource Scroll.Reading}" Margin="0,12,0,0" TabIndex="0"
                                  AutomationProperties.Name="What will change">
                        <StackPanel Margin="0,0,12,4">
                            <!-- Installing -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallDriver}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExportOnly}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource ChangeIcon}" Text="&#xE777;" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="A System Restore point is created first." />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource ChangeIcon}" Text="&#xEB95;" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="This PC trusts the app's own signing certificate, so Windows accepts the converted driver." />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource ChangeIcon}" Text="&#xE7F4;" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="The converted AMD driver replaces Lenovo's. Lenovo's driver stays available for rolling back." />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0" Visibility="{Binding InstallAmdSoftware, Converter={StaticResource BoolVisible}}">
                                    <TextBlock Style="{StaticResource ChangeIcon}" Text="&#xE74D;" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Lenovo's AMD Software app from the Microsoft Store is removed, then AMD Software is installed." />
                                </DockPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource ChangeIcon}" Text="&#xE72C;" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="Windows may need a restart at the end." />
                                </DockPanel>
                            </StackPanel>

                            <!-- Not installing -->
                            <StackPanel Margin="0,10,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding InstallDriver}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExportOnly}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Style="{StaticResource Text.Title}" FontSize="28" Text="Nothing will be installed." />
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0" Text="The app only builds the converted driver and leaves this Legion Go as it is."
                                           Visibility="{Binding IsExportOnly, Converter={StaticResource BoolVisible}, ConverterParameter=invert}" />
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0"
                                           Text="The converted driver is saved to the export folder. No restore point, certificate or driver changes on this Legion Go."
                                           Visibility="{Binding IsExportOnly, Converter={StaticResource BoolVisible}}" />
                            </StackPanel>

                            <!-- This Legion Go: read-only facts -->
                            <Border Margin="0,18,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Muted}" Text="Graphics hardware ID" />
                                    <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding DeviceId, TargetNullValue='Not found'}" />
                                    <Border Style="{StaticResource Banner.Danger}" Margin="0,10,0,0"
                                            Visibility="{Binding DeviceError, Converter={StaticResource EmptyCollapsed}}">
                                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DeviceError}" />
                                    </Border>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Muted}" Text="Secure Boot" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource FactValue}" Tag="{Binding Security.SecureBoot, FallbackValue={x:Null}}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Muted}" Text="Memory Integrity" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource FactValue}" Tag="{Binding Security.Hvci, FallbackValue={x:Null}}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,0"
                                               Text="Both stay as they are. The app never changes Secure Boot or Memory Integrity." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right: the options (the only things to change on this screen) -->
            <ScrollViewer Grid.Column="2" KeyboardNavigation.DirectionalNavigation="Continue">
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Heading}" Text="Options" Margin="0,0,0,14" />
                        <CheckBox x:Name="InstallDriverToggle" Style="{StaticResource Toggle.Option}" IsChecked="{Binding InstallDriver}"
                                  IsEnabled="{Binding IsExportOnly, Converter={StaticResource Not}}" TabIndex="1">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Install the converted driver" />
                                <TextBlock Style="{StaticResource Text.Muted}" Text="Replaces Lenovo's graphics driver." />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="InstallAmdSoftwareToggle" Style="{StaticResource Toggle.Option}" Margin="0,14,0,0"
                                  IsChecked="{Binding InstallAmdSoftware}" IsEnabled="{Binding IsExportOnly, Converter={StaticResource Not}}" TabIndex="2">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Install AMD Software" />
                                <TextBlock Style="{StaticResource Text.Muted}" Text="AMD's settings app (Adrenalin). Needs the driver install." />
                            </StackPanel>
                        </CheckBox>

                        <Border Margin="0,18,0,0" Padding="0,16,0,0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="Export only" />
                                <TextBlock Style="{StaticResource Text.Muted}"
                                           Text="Save the converted driver to a folder instead of installing it, for use on your own PC." />
                                <TextBlock Style="{StaticResource Text.Body}" Margin="0,10,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ExportFolder}" ToolTip="{Binding ExportFolder}"
                                           Visibility="{Binding IsExportOnly, Converter={StaticResource BoolVisible}}" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="ExportButton" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseExportCommand}"
                                            TabIndex="3" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B7;" Margin="0,0,12,0" />
                                            <TextBlock Text="Choose export folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ClearExportCommand}"
                                            Content="Install instead" TabIndex="4"
                                            Visibility="{Binding IsExportOnly, Converter={StaticResource BoolVisible}}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
