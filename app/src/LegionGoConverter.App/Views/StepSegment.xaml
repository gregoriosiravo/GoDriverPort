<UserControl x:Class="LegionGoConverter.App.Views.StepSegment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self" Focusable="False" IsTabStop="False">
    <!-- Colours are set from code by Position (theme resource references, so theme swaps still apply). -->
    <StackPanel Margin="6,0">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border x:Name="Badge" Width="30" Height="30" CornerRadius="15" BorderThickness="2" Margin="0,0,10,0">
                <Grid>
                    <TextBlock x:Name="NumberText" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock x:Name="DoneGlyph" Style="{StaticResource Text.Icon}" FontSize="14" Text="&#xE73E;" Visibility="Collapsed" />
                </Grid>
            </Border>
            <TextBlock x:Name="LabelText" Text="{Binding Label, ElementName=Self}" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border x:Name="Bar" Height="6" CornerRadius="3" />
    </StackPanel>
</UserControl>
